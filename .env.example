# Smart Civic Issue Reporting System Environment Configuration
# Flask Settings
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=smart-civic-issue-system-secret-key-tezu-2026

# Database Settings
# Set DB_TYPE to 'mysql' to use MySQL Server.
# If MySQL connection fails, system gracefully uses local SQLite store so app never crashes.
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=civic_issue_db
